			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color hidden="#0000">#F223</color>
		</square>
	</element>

	<element name="editbox">
		<font	format="VCENTER">
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#FDDD" disabled="#CCCC" hidden="#0CCC" focus="#FDDD" mouseover="#FDDD" pressed="#FDDD"/>
		</font>
		<offset>4,3,-3,-4</offset>
	</element>

	<element name="editbox.caret">
		<square>
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#F000" disabled="#EEEE" hidden="#0FFF" focus="#FFFF" mouseover="#FFFF" pressed="#FFFF"/>
		</square>
	</element>

	<element name="imeeditbox">
		<font format="LEFT|TOP">
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#F888" disabled="#F832" hidden="#F832" focus="#F800" mouseover="#F832" pressed="#F832"/>
		</font>
	</element>

	<element name="propertygrid">
		<texture1 filename="Texture/skin.bmp" name="ListBoxMain" rect="0,100,14,14" center_rect="5,5,3,3"/>
		<texture1 filename="Texture/skin.bmp" name="ListBoxSelection" rect="32,16,48,32">
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#42C2" disabled="#42C2" hidden="#02C2" focus="#42C2" mouseover="#42C2" pressed="#42C2"/>
		</texture1>
		<font format="LEFT|TOP">
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#F888" disabled="#F832" hidden="#F832" focus="#F800" mouseover="#F832" pressed="#F832"/>
		</font>
		<font format="LEFT|TOP">
			<blend pressed="0.0" hidden="0.5">0.8</blend>
			<color normal="#F888" disabled="#F832" hidden="#F832" focus="#F800" mouseover="#F832" pressed="#F832"/>
		</font>
	</element>
</root>