function OnCharacterEntry(aIndex)

	local UserMax  = GetGameServerMaxUser()

	local User = GetGameServerCurUser()


	NoticeSend(aIndex,1,string.format("Jugadores ON: %d / %d", User, UserMax))
	NoticeSend(aIndex,1,"Comandos: /move /reset /post /pick zen")

end


function OnCharacterClose(aIndex)

end


function OnNpcTalk(aIndex,bIndex)

	local texto = BuscarSaludo(bIndex)

	if texto ~= nil then
		NoticeSend(aIndex,1,texto)
	end

	return 0

end


